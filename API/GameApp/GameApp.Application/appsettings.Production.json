{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "GameApp",
    "Audience": "GameApp.FrontEnd",
    "SigningKey": "REPLACE_IN_PRODUCTION_WITH_ENV_OR_SECRET_STORE",
    "ExpirationMinutes": 120
  },
  "ConnectionStrings": {
    "Default": "Data Source=/var/app/DB_Data/gameapp.db"
  },
  "Gallery": {
    "ImagesRoot": "/var/app/wwwroot/images",
    "DrawingsRoot": "/var/app/wwwroot/drawings",
    "MaxFileSizeBytes": 5242880
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      }
    },
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  }
}